{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test --allow-read=.,../app/assets/fixtures",
    "check": "deno check supabase/functions scripts testdata",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno fmt --check && deno lint && deno check supabase/functions scripts testdata && deno test --allow-read=.,../app/assets/fixtures"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100
  }
}
