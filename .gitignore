# Workspace
.idea/
.vscode/
*.log

# Local agent/assistant working rules. Kept on disk, never published.
CLAUDE.md
.claude/

# Local secrets and generated environment files
.env
.env.*
!.env.example
**/google-services.json
**/GoogleService-Info.plist
**/*.jks
**/*.keystore

# Flutter / Dart
app/.dart_tool/
app/.packages
app/.pub-cache/
app/build/
app/coverage/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/ephemeral/
app/macos/Flutter/ephemeral/

# Diff images flutter_test writes next to a failing golden. Debugging output,
# not a reference: the reference images live in test/golden/goldens/.
app/test/golden/failures/

# Code generation
app/lib/**/*.freezed.dart
app/lib/**/*.g.dart

